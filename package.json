{
  "name": "@cerealbox/hooks",
  "version": "0.1.0",
  "description": "Install lifecycle hooks into Claude Code and Codex from a portable package. The hooks analog of npx skills.",
  "type": "module",
  "bin": {
    "hooks": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "obuild",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "marked": "^18.0.9",
    "picocolors": "^1.1.1",
    "tar": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "obuild": "^0.4.38",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "cli",
    "hooks",
    "claude-code",
    "codex",
    "ai",
    "agent",
    "lifecycle"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cereal-dot-box/hooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cereal-dot-box/hooks.git"
  }
}
